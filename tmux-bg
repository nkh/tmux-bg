#!/usr/bin/env bash
#
# tmux-bg - run and manage one program window per program/directory.
#
set -euo pipefail

DEFAULT_SESSION="programs"
SESSION="$DEFAULT_SESSION"
ATTACH_AFTER_START=0
POPUP_WIDTH="95%"
POPUP_HEIGHT="90%"
NO_POPUP=0

usage() {
    cat <<'EOF'
Usage:
  tmux-bg [--session NAME] run [--attach] [--close-on-exit] PROGRAM [ARG...]
  tmux-bg [--session NAME] [--popup-width W] [--popup-height H] switch
  tmux-bg [--session NAME] [--popup-width W] [--popup-height H] kill
  tmux-bg [--session NAME] list
  tmux-bg [--session NAME] clean-up

Commands:
  run       Start PROGRAM in a detached managed window.
  switch    Pick a managed window with fzf and switch to it. From inside
            the manager session, switch straight back to the previous one.
  kill      Pick one or more managed windows with fzf and kill them.
  list      Print managed windows.
  clean-up  Remove managed windows whose panes have exited.

Options:
  --session NAME     Use another tmux session (default: programs).
  --popup-width W    Picker popup width, cells or percent (default: 95%).
  --popup-height H   Picker popup height, cells or percent (default: 90%).
  --no-popup         Never open a popup: pick inline in the current
                     terminal instead.
  --attach           After starting or finding a program, switch to it.
  -h, --help         Show this help.

The run command is detached by default. PROGRAM may be a PATH command or a
shell alias from your rc files (v can start vim). PROGRAM is identified by
its resolved executable path and the canonical current directory; arguments
do not create separate instances: the same executable in the same directory
is one instance. If the instance was started with different arguments, the
new arguments are ignored and tmux-bg says so.

A managed window stays open when its program exits, so output and errors
remain visible; clean-up removes exited windows. --close-on-exit closes the
window as soon as the program exits instead.
EOF
}

die() {
    printf 'tmux-bg: %s\n' "$*" >&2
    exit 1
}

require_tmux() {
    [[ -n "${TMUX:-}" ]] || die "must be run inside tmux"
    command -v tmux >/dev/null 2>&1 || die "tmux not found"
}

require_fzf() {
    command -v fzf >/dev/null 2>&1 || die "fzf is required for this command"
}

session_exists() {
    tmux has-session -t "=$SESSION" 2>/dev/null
}

current_session() {
    # No explicit -t target: TMUX_PANE is not set inside display-popup or
    # run-shell jobs (they are not panes), and `set -u` aborts on it.
    # Without -t, tmux resolves the current pane when run from a pane and
    # the invoking client's session when run from a popup.
    tmux display-message -p '#{session_name}'
}

window_option() {
    local target=$1 option=$2
    tmux show-option -wqv -t "$target" "$option" 2>/dev/null || true
}

managed_windows() {
    local window program directory
    while IFS= read -r window; do
        [[ -n "$window" ]] || continue
        program="$(window_option "$window" @managed_program)"
        [[ -n "$program" ]] || continue
        directory="$(window_option "$window" @managed_directory)"
        printf '%s\t%s\t%s\n' "$window" "$program" "$directory"
    done < <(tmux list-windows -t "=$SESSION" -F '#{window_id}' 2>/dev/null)
}

safe_display() {
    # Keep fzf's tab-separated record format intact.
    local value=$1
    value=${value//$'\t'/ }
    value=${value//$'\n'/ }
    printf '%s' "$value"
}

window_title() {
    local program=$1 directory=$2
    local base
    base="$(basename -- "$directory")"
    [[ -n "$base" ]] || base="/"
    printf '%s - %s' "$(basename -- "$program")" "$base"
}

switch_to_window() {
    local target=$1

    # Already in the manager session: select the window in place. Going
    # through switch-client here would be wrong for `run --attach`, which
    # is asked to show a program, not to leave the manager session.
    if [[ "$(current_session)" == "$SESSION" ]]; then
        tmux select-window -t "$target"
        return
    fi

    tmux switch-client -t "=$SESSION"
    tmux select-window -t "$target"
}

resolve_program() {
    # Resolve REQUESTED to something runnable: a PATH command, or a shell
    # alias from the user's interactive rc files. Aliases do not exist in
    # non-interactive shells, so ask one: `v' may expand to `vim -o'.
    local requested=$1 expansion
    if command -v -- "$requested" >/dev/null 2>&1; then
        printf '%s\n' "$requested"
        return 0
    fi
    expansion="$(bash -ic 'type -- "$1"' _ "$requested" 2>/dev/null |
        grep -m1 'aliased to' || true)"
    [[ -n "$expansion" ]] || return 1
    expansion="${expansion#*\`}"
    expansion="${expansion%\'}"
    printf '%s\n' "$expansion"
}

window_pane_dead() {
    # 1 when every pane of the window has exited, 0 otherwise.
    tmux list-panes -t "$1" -F '#{pane_dead}' 2>/dev/null | head -n 1 || true
}

find_existing() {
    local wanted_program=$1 wanted_directory=$2
    local window program directory

    while IFS=$'\t' read -r window program directory; do
        [[ -n "$window" ]] || continue
        # A leftover window with exited panes is not a running instance:
        # start a new one instead of focusing the dead window.
        if [[ "$(window_pane_dead "$window")" == "1" ]]; then
            continue
        fi
        if [[ "$program" == "$wanted_program" &&
              "$directory" == "$wanted_directory" ]]; then
            printf '%s\n' "$window"
            return 0
        fi
    done < <(managed_windows)
    return 1
}

check_spawn() {
    # Briefly watch a freshly started window. When the process dies at
    # once with a failing status (unknown command, bad arguments), surface
    # the pane output as an error instead of failing silently. The window
    # itself is kept by remain-on-exit for inspection.
    local window_id=$1 requested=$2
    local i dead="" status="" output

    for i in 1 2 3 4 5; do
        sleep 0.2
        dead="$(window_pane_dead "$window_id")"
        if [[ "$dead" == "1" ]]; then
            break
        fi
        dead=""
    done
    [[ "$dead" == "1" ]] || return 0

    status="$(tmux list-panes -t "$window_id" -F '#{pane_dead_status}' 2>/dev/null | head -n 1 || true)"
    if [[ -z "$status" || "$status" == "0" ]]; then
        return 0  # exited cleanly: not an error, output stays in the window
    fi

    output="$(tmux capture-pane -p -t "$window_id" 2>/dev/null |
        grep -m1 -v '^[[:space:]]*$' || true)"
    [[ -n "$output" ]] || output="(no output)"
    if [[ ${#output} -gt 80 ]]; then
        output="${output:0:77}..."
    fi

    local message="tmux-bg: $requested exited immediately (exit $status): $output"
    printf '%s\n' "$message"
    tmux display-message "$message" 2>/dev/null || true
}

run_program() {
    local attach=$ATTACH_AFTER_START
    local keep=1
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            --attach)        attach=1 ;;
            --close-on-exit) keep=0 ;;
            --)              shift; break ;;
            *)               die "unknown run option: $1 (try --help)" ;;
        esac
        shift
    done
    (($# >= 1)) || die "run requires PROGRAM [ARG...]"

    local requested=$1
    shift

    # Accept PATH commands and shell aliases (v -> vim -o).
    local -a cmd_words=()
    local resolution
    if ! resolution="$(resolve_program "$requested")"; then
        die "program not found: $requested"
    fi
    read -r -a cmd_words <<< "$resolution"
    [[ ${#cmd_words[@]} -ge 1 ]] || die "program not found: $requested"

    local executable
    executable="$(command -v -- "${cmd_words[0]}")" ||
        die "cannot resolve program: ${cmd_words[0]}"
    executable="$(readlink -f -- "$executable")" ||
        die "cannot resolve executable: $executable"
    [[ -x "$executable" ]] || die "not executable: $executable"
    cmd_words[0]="$executable"

    local directory
    directory="$(pwd -P)"

    require_tmux

    if session_exists; then
        local existing
        if existing="$(find_existing "$executable" "$directory")"; then
            printf 'Already running: %s in %s\n' "$requested" "$directory"
            local stored_args
            stored_args="$(window_option "$existing" @managed_args)"
            if [[ -n "$*" && "$*" != "$stored_args" ]]; then
                printf 'Note: keeping the original arguments of the instance (%s), new ones ignored: %s\n' \
                    "${stored_args:-(none)}" "$*"
            fi
            if (( attach )); then
                switch_to_window "$existing"
            fi
            return 0
        fi
    fi

    # Quote every argument for the shell tmux uses to start the pane command.
    local command_line
    printf -v command_line '%q ' "${cmd_words[@]}" "$@"
    command_line="exec ${command_line% }"

    local title window_id
    title="$(window_title "$executable" "$directory")"

    # remain-on-exit keeps the window when the process exits, so output and
    # errors stay visible and quick commands (run ls) survive long enough
    # for the bookkeeping below. It is chained onto the same tmux call so
    # it is in place before the process can possibly exit.
    local keep_value=on
    (( keep )) || keep_value=off

    if session_exists; then
        window_id="$(
            tmux new-window -d -P -F '#{window_id}' \
                -t "=$SESSION" -c "$directory" -n "$title" "$command_line" \
                \; set-option -w remain-on-exit "$keep_value"
        )"
    else
        window_id="$(
            tmux new-session -d -P -F '#{window_id}' \
                -s "$SESSION" -c "$directory" -n "$title" "$command_line" \
                \; set-option -w remain-on-exit "$keep_value"
        )"
    fi
    [[ -n "$window_id" ]] || die "tmux did not report a window id"

    tmux set-option -w -t "$window_id" @managed_program "$executable"
    tmux set-option -w -t "$window_id" @managed_directory "$directory"
    tmux set-option -w -t "$window_id" @managed_title "$title"
    tmux set-option -w -t "$window_id" @managed_args "$*"
    tmux set-option -w -t "$window_id" @managed_version "1"

    printf 'Started %s in session %s: %s\n' "$requested" "$SESSION" "$title"
    if (( attach )); then
        switch_to_window "$window_id"
    else
        check_spawn "$window_id" "$requested"
    fi
}

picker_records() {
    local window program directory title
    while IFS=$'\t' read -r window program directory; do
        [[ -n "$window" ]] || continue
        title="$(window_option "$window" @managed_title)"
        [[ -n "$title" ]] || title="$(window_title "$program" "$directory")"
        printf '%s\t%s\t%s\t%s\n' \
            "$window" \
            "$(safe_display "$title")" \
            "$(safe_display "$directory")" \
            "$(safe_display "$program")"
    done < <(managed_windows)
}

pick_windows() {
    local action=$1
    require_tmux

    # Pressing switch while already in the manager session is the toggle:
    # return the client to its previous session, without opening the picker.
    if [[ "$action" == "switch" ]] && [[ "$(current_session)" == "$SESSION" ]]; then
        if tmux switch-client -l 2>/dev/null; then
            return 0
        fi
        # No previous session to return to (none recorded, or it died):
        # fall through to the picker so the key still does something useful.
    fi

    session_exists || die "session '$SESSION' does not exist"

    local records
    records="$(picker_records)"
    [[ -n "$records" ]] || die "no managed programs in session '$SESSION'"

    # With a single managed program there is nothing to choose from:
    # select it directly instead of opening the fzf popup. Records are
    # sanitized by safe_display, so each one is exactly one line.
    if [[ "$action" != "kill" ]] && [[ "$records" != *$'\n'* ]]; then
        switch_to_window "${records%%$'\t'*}"
        return 0
    fi

    # fzf needs a terminal to draw in. Started from a key binding without
    # a popup wrapper (run-shell) there is none: re-run this script inside
    # a tmux popup and pick there. Inside a popup or a pane stdin is a tty,
    # so the re-invocation skips this and the popup opens at most once.
    # The records were checked above, so the popup only opens when there
    # is something to pick. --no-popup keeps the picker inline instead;
    # then a real terminal is required.
    if [[ -z "${TMUX_BG_POPUP:-}" ]] && [[ ! -t 0 ]]; then
        if (( NO_POPUP )); then
            die "--no-popup needs a terminal: run tmux-bg $action inside a pane"
        fi
        local self=$0
        if [[ "$self" != */* ]]; then
            self="$(command -v -- "$self" || printf '%s' "$self")"
        fi
        exec tmux display-popup -E \
            -w "$POPUP_WIDTH" -h "$POPUP_HEIGHT" \
            env TMUX_BG_POPUP=1 "$self" --session "$SESSION" "$action"
    fi

    require_fzf

    local selected
    if [[ "$action" == "kill" ]]; then
        selected="$(
            printf '%s\n' "$records" |
                fzf --multi \
                    --delimiter=$'\t' --with-nth='2..' \
                    --prompt='Kill programs > ' \
                    --header='Tab: mark multiple  Enter: kill  Esc: cancel' \
                    --preview='tmux capture-pane -p -e -t {1}' \
                    --preview-window='right,60%,border-left'
        )" || return 0
    else
        selected="$(
            printf '%s\n' "$records" |
                fzf \
                    --delimiter=$'\t' --with-nth='2..' \
                    --preview='tmux capture-pane -p -e -t {1}' \
                    --preview-window='bottom,75%,border-top'
        )" || return 0
    fi

    [[ -n "$selected" ]] || return 0

    if [[ "$action" == "kill" ]]; then
        while IFS= read -r line; do
            local target=${line%%$'\t'*}
            [[ -n "$target" ]] || continue
            tmux kill-window -t "$target"
            printf 'Killed %s\n' "$target"
        done <<< "$selected"
    else
        local target=${selected%%$'\t'*}
        switch_to_window "$target"
    fi
}

list_programs() {
    require_tmux
    if ! session_exists; then
        printf 'No session: %s\n' "$SESSION"
        return 0
    fi

    printf '%-10s  %-32s  %s\n' "WINDOW" "PROGRAM" "DIRECTORY"
    while IFS=$'\t' read -r window program directory; do
        [[ -n "$window" ]] || continue
        printf '%-10s  %-32s  %s\n' "$window" \
            "$(basename -- "$program")" "$directory"
    done < <(managed_windows)
}

clean_up() {
    require_tmux
    if ! session_exists; then
        printf 'Nothing to clean: session %s does not exist\n' "$SESSION"
        return 0
    fi

    local window dead killed=0
    while IFS= read -r window; do
        [[ -n "$window" ]] || continue
        [[ -n "$(window_option "$window" @managed_program)" ]] || continue

        # Only remove a window when all of its panes have exited.
        dead="$(
            tmux list-panes -t "$window" -F '#{pane_dead}' 2>/dev/null |
                sort -u
        )"
        if [[ "$dead" == "1" ]]; then
            tmux kill-window -t "$window"
            printf 'Removed dead managed window %s\n' "$window"
            ((killed += 1))
        fi
    done < <(tmux list-windows -t "=$SESSION" -F '#{window_id}')

    printf 'Clean-up complete: %d dead window(s) removed\n' "$killed"
}

main() {
    # Every command calls require_tmux itself; --help must work anywhere.

    while (($#)); do
        case "$1" in
            --session)
                (($# >= 2)) || die "--session requires a name"
                SESSION=$2
                shift 2
                ;;
            --popup-width|--popup-height)
                (($# >= 2)) || die "$1 requires a value"
                [[ "$2" =~ ^[0-9]+%?$ ]] ||
                    die "$1 expects a size like 80 or 95%"
                if [[ "$1" == "--popup-width" ]]; then
                    POPUP_WIDTH=$2
                else
                    POPUP_HEIGHT=$2
                fi
                shift 2
                ;;
            --no-popup)
                NO_POPUP=1
                shift
                ;;
            --attach)
                ATTACH_AFTER_START=1
                shift
                ;;
            -h|--help)
                usage
                return 0
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    [[ -n "$SESSION" ]] || die "session name cannot be empty"
    (($# >= 1)) || { usage; return 2; }

    local command=$1
    shift

    case "$command" in
        run)      run_program "$@" ;;
        switch|pick) pick_windows switch ;;
        kill)     pick_windows kill ;;
        list)     list_programs ;;
        clean-up|cleanup) clean_up ;;
        help)     usage ;;
        *)        die "unknown command: $command (try --help)" ;;
    esac
}

main "$@"
